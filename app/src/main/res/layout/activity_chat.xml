<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/aBg0">
  <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/aBg1" android:paddingEnd="4dp">
    <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_back" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Back"/>
    <LinearLayout android:id="@+id/headerInfo" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground">
      <ImageView android:id="@+id/ivAvatar" android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop" android:background="@drawable/bg_circle" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="avatar"/>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="?attr/aTxtHi" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/aTxtMid" android:maxLines="1"/>
      </LinearLayout>
    </LinearLayout>
    <ImageButton android:id="@+id/btnAudio" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_call" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Audio call"/>
    <ImageButton android:id="@+id/btnVideo" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_videocam" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Video call"/>
    <ImageButton android:id="@+id/btnMenu" android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_more" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="More"/>
  </LinearLayout>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMessages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="6dp" android:paddingBottom="6dp"/>
  <LinearLayout android:id="@+id/replyBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/aBg1" android:paddingStart="14dp" android:paddingEnd="4dp" android:visibility="gone">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/tvReplyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Replying" android:textSize="12sp" android:textColor="?attr/aPrimary"/>
      <TextView android:id="@+id/tvReplyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="?attr/aTxtMid" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <ImageButton android:id="@+id/btnReplyClose" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_close" android:tint="?attr/aTxtMid" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Cancel reply"/>
  </LinearLayout>
  <TextView android:id="@+id/tvRec" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="?attr/aDanger" android:background="?attr/aBg1" android:padding="8dp" android:layout_width="match_parent" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:background="?attr/aBg1" android:paddingStart="4dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="8dp">
    <ImageButton android:id="@+id/btnAttach" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_attach" android:tint="?attr/aTxtMid" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Attach"/>
    <EditText android:id="@+id/etMessage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="44dp" android:maxLines="5" android:background="@drawable/bg_input" android:hint="Message" android:inputType="textCapSentences|textMultiLine" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp"/>
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="6dp">
      <ImageButton android:id="@+id/btnSend" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:src="@drawable/ic_send" android:tint="?attr/aBg0" android:background="@drawable/bg_send" android:padding="11dp" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="Send"/>
      <ImageButton android:id="@+id/btnMic" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:src="@drawable/ic_mic" android:tint="?attr/aBg0" android:background="@drawable/bg_send" android:padding="11dp" android:scaleType="fitCenter" android:contentDescription="Hold to record a voice note"/>
    </FrameLayout>
  </LinearLayout>
</LinearLayout>
