<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/aBg0">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
    <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="24dp" android:src="@drawable/ic_logo" android:contentDescription="Aether logo"/>
    <TextView android:id="@+id/tvTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Welcome back" android:textSize="24sp" android:textColor="?attr/aTxtHi" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Message at the speed of light." android:textSize="13sp" android:textColor="?attr/aTxtMid" android:layout_marginBottom="24dp"/>
    <LinearLayout android:id="@+id/groupRegister" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input" android:hint="Display name" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="textPersonName" android:layout_marginBottom="12dp"/>
      <EditText android:id="@+id/etUsername" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input" android:hint="Username (a-z, 0-9, _)" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="textNoSuggestions" android:layout_marginBottom="12dp"/>
    </LinearLayout>
    <EditText android:id="@+id/etId" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input" android:hint="Username or email" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="textEmailAddress" android:layout_marginBottom="12dp"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <EditText android:id="@+id/etPass" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bg_input" android:hint="Password" android:paddingStart="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="textPassword" android:paddingEnd="52dp"/>
      <ImageButton android:id="@+id/btnEye" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="4dp" android:src="@drawable/ic_eye" android:tint="?attr/aTxtMid" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:contentDescription="Show or hide password"/>
    </FrameLayout>
    <TextView android:id="@+id/tvStrength" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/aTxtLow" android:layout_gravity="start" android:layout_marginTop="6dp" android:visibility="gone"/>
    <CheckBox android:id="@+id/cbRemember" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:checked="true" android:text="Remember me" android:textColor="?attr/aTxtMid" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tvError" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="?attr/aDanger" android:layout_marginTop="8dp" android:visibility="gone"/>
    <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:text="Sign in" android:textStyle="bold"/>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="12dp" android:visibility="gone"/>
    <TextView android:id="@+id/tvForgot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forgot password?" android:textSize="14sp" android:textColor="?attr/aSky" android:layout_marginTop="16dp" android:padding="8dp"/>
    <TextView android:id="@+id/tvToggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New here? Create an account" android:textSize="14sp" android:textColor="?attr/aPrimary" android:padding="8dp"/>
  </LinearLayout>
</ScrollView>
