<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="8dp">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aether" android:textSize="28sp" android:textColor="?attr/aTxtHi" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
      <ImageButton android:id="@+id/btnSettings" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_settings" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Settings"/>
    </LinearLayout>
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_input" android:hint="Search chats or @username" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="text"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="10dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All" android:textSize="13sp" android:textColor="?attr/aTxtHi" android:background="@drawable/bg_chip_on" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginEnd="8dp"/><TextView android:id="@+id/chipUnread" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Unread" android:textSize="13sp" android:textColor="?attr/aTxtHi" android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginEnd="8dp"/><TextView android:id="@+id/chipArchived" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Archived" android:textSize="13sp" android:textColor="?attr/aTxtHi" android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cardResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:layout_margin="12dp" android:padding="12dp" android:visibility="gone">
      <ImageView android:id="@+id/ivResult" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:background="@drawable/bg_circle" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="avatar"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvResultName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="?attr/aTxtHi" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tvResultSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View profile" android:textSize="13sp" android:textColor="?attr/aSky"/>
      </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvChats" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="80dp"/>
      <LinearLayout android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:visibility="gone">
        <ImageView android:layout_width="84dp" android:layout_height="84dp" android:src="@drawable/ic_logo" android:alpha="0.7" android:contentDescription="Aether"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="The aether is quiet. Add a friend to begin." android:textSize="16sp" android:textColor="?attr/aTxtMid" android:layout_marginTop="16dp" android:gravity="center"/>
        <Button android:id="@+id/btnEmptyAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Add a friend"/>
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
  <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fabAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="20dp" app:srcCompat="@drawable/ic_person_add" app:backgroundTint="?attr/aPrimary" app:tint="?attr/aBg0" android:contentDescription="Add friend"/>
</FrameLayout>
