<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
  <TextView android:id="@+id/tvDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="12sp" android:textColor="?attr/aTxtMid" android:visibility="gone"/>
  <LinearLayout android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <LinearLayout android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:minWidth="72dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/bg_bubble_recv">
      <TextView android:id="@+id/tvForwarded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↪ Forwarded" android:textSize="11sp" android:textColor="?attr/aTxtLow" android:textStyle="italic" android:visibility="gone"/>
      <LinearLayout android:id="@+id/replyBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_reply" android:padding="6dp" android:layout_marginBottom="4dp" android:visibility="gone">
        <TextView android:id="@+id/tvReply" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="?attr/aTxtMid" android:maxLines="2" android:ellipsize="end"/>
      </LinearLayout>
      <ImageView android:id="@+id/ivMedia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxWidth="240dp" android:maxHeight="300dp" android:minWidth="120dp" android:minHeight="90dp" android:scaleType="fitCenter" android:visibility="gone" android:layout_marginBottom="4dp" android:contentDescription="Photo"/>
      <LinearLayout android:id="@+id/fileRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_file" android:tint="?attr/aSky" android:contentDescription="File"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
          <TextView android:id="@+id/tvFileName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="190dp" android:textSize="14sp" android:textColor="?attr/aTxtHi" android:maxLines="1" android:ellipsize="middle"/>
          <TextView android:id="@+id/tvFileSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="?attr/aTxtLow"/>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout android:id="@+id/voiceRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/ivPlay" android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_play" android:tint="?attr/aPrimary" android:padding="4dp" android:contentDescription="Play voice message"/>
        <ProgressBar android:id="@+id/pbVoice" style="?android:attr/progressBarStyleHorizontal" android:layout_width="120dp" android:layout_height="wrap_content" android:max="100" android:progress="0" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/tvVoiceDur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textSize="12sp" android:textColor="?attr/aTxtMid" android:layout_marginStart="8dp"/>
      </LinearLayout>
      <TextView android:id="@+id/tvText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15.5sp" android:textColor="?attr/aTxtHi" android:textColorLink="?attr/aSky"/>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tvEdited" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="edited" android:textSize="10sp" android:textColor="?attr/aTxtLow" android:layout_marginEnd="4dp" android:visibility="gone"/>
        <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="11sp" android:textColor="?attr/aTxtLow"/>
        <TextView android:id="@+id/tvTick" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="?attr/aTxtLow" android:layout_marginStart="4dp"/>
      </LinearLayout>
      <TextView android:id="@+id/tvReactions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="?attr/aTxtHi" android:visibility="gone"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
