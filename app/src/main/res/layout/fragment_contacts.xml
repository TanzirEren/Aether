<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="20dp" android:text="Contacts" android:textSize="22sp" android:textColor="?attr/aTxtHi" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical">
      <EditText android:id="@+id/etUsername" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Add by @username" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="?attr/aTxtHi" android:textColorHint="?attr/aTxtLow" android:textSize="16sp" android:maxLines="1" android:inputType="textNoSuggestions" android:imeOptions="actionSearch"/>
      <Button android:id="@+id/btnSearch" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="Find"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/cardPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:layout_margin="16dp" android:padding="14dp" android:visibility="gone">
      <ImageView android:id="@+id/ivPreview" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:background="@drawable/bg_circle" android:clipToOutline="true" android:outlineProvider="background" android:contentDescription="avatar"/>
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/tvPreviewName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="?attr/aTxtHi" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/tvPreviewSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="?attr/aTxtMid"/>
        <TextView android:id="@+id/tvPreviewBio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="?attr/aTxtLow" android:maxLines="2" android:ellipsize="end"/>
      </LinearLayout>
      <Button android:id="@+id/btnPreviewAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send request" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingBottom="6dp">
      <TextView android:id="@+id/chipFriends" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Friends" android:textSize="13sp" android:textColor="?attr/aTxtHi" android:background="@drawable/bg_chip_on" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginEnd="8dp"/><TextView android:id="@+id/chipSent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sent requests" android:textSize="13sp" android:textColor="?attr/aTxtHi" android:background="@drawable/bg_chip" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvContacts" android:layout_width="match_parent" android:layout_height="match_parent"/>
      <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nobody here yet" android:textSize="15sp" android:textColor="?attr/aTxtMid" android:layout_gravity="center" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
