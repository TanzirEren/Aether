<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/aBg0">
  <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/aBg1">
    <ImageButton android:id="@+id/btnClose" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:tint="?attr/aTxtHi" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Close"/>
    <TextView android:id="@+id/tvUrl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="14sp" android:textColor="?attr/aTxtMid" android:maxLines="1" android:ellipsize="middle"/>
    <ImageButton android:id="@+id/btnCopy" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_file" android:tint="?attr/aTxtMid" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Copy link"/>
    <ImageButton android:id="@+id/btnExternal" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_share" android:tint="?attr/aTxtMid" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:scaleType="fitCenter" android:contentDescription="Open in browser"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="100" android:visibility="gone"/>
  <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
